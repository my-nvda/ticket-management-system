# Application Configuration
SECRET_KEY=change-this-to-a-secure-random-string-in-production
DATABASE_URL=sqlite:///tickets.db

# Admin Authentication Settings
# Set to 'true' to require password login for /admin routes, 'false' for open access
ADMIN_AUTH_ENABLED=false
ADMIN_PASSWORD=admin123

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB limit

# WhatsApp Notification Settings (Primary Channel)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_access_token
WHATSAPP_RECIPIENT_NUMBER=201010810808
# Telegram Bot Settings (Fallback Channel)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Generic Webhook Settings (Alternative)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/api/tickets
